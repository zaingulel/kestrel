[Unit]
Description=Kestrel local Bonsai brain
PartOf=graphical-session.target kestrel-voice.service

[Service]
Type=exec
WorkingDirectory=%h/Projects/zaingulel/kestrel
ExecStart=/usr/bin/env -i HOME=%h PATH=/usr/bin:/bin LANG=C.UTF-8 XDG_RUNTIME_DIR=%t /usr/bin/bash %h/Projects/zaingulel/kestrel/run-brain.sh
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/Projects/zaingulel/kestrel/.runtime/brain-compute-cache
ExecStartPost=+/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 MAINPID=${MAINPID} /usr/bin/bash %h/Projects/zaingulel/kestrel/check-network-fence.sh
ExecStartPost=+/usr/bin/env -i HOME=%h PATH=/usr/bin:/bin LANG=C.UTF-8 XDG_RUNTIME_DIR=%t MAINPID=${MAINPID} /usr/bin/bash %h/Projects/zaingulel/kestrel/check-brain-ready.sh
TimeoutStartSec=130s
TimeoutStopSec=15s
Restart=no
KillMode=control-group
StandardOutput=append:%h/Projects/zaingulel/kestrel/.runtime/brain-server.log
StandardError=inherit
ProtectSystem=strict
ProtectHome=tmpfs
PrivateNetwork=yes
PrivateUsers=self
PrivateTmp=disconnected
PrivateDevices=yes
NoNewPrivileges=yes
PrivateIPC=yes
PrivatePIDs=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~connect io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
InaccessiblePaths=-/dev/shm -/dev/mqueue -/dev/pts -/dev/ptmx -/dev/hugepages -/var/log -/run/log -/run/docker.sock -/run/dbus -/run/systemd -/run/udev -/run/tailscale -/run/cups -/run/avahi-daemon -/run/ssh-unix-local -/run/polkit
RuntimeDirectory=kestrel-brain
RuntimeDirectoryMode=0700
BindPaths=/dev/nvidia0 /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset %t/kestrel-brain %h/Projects/zaingulel/kestrel/.runtime/brain-compute-cache
BindReadOnlyPaths=%h/Projects/zaingulel/kestrel/run-brain.sh %h/Projects/zaingulel/kestrel/.runtime/brain-api-key %h/Projects/zaingulel/kestrel/.runtime/models/bonsai-2-27b %h/Projects/zaingulel/kestrel/.runtime/tools/bonsai-prism-b10787-73bfe6c %h/Projects/zaingulel/kestrel/.runtime/tools/cudart-b11815-cuda-12.8
