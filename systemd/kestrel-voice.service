[Unit]
Description=Kestrel local voice conversation
Wants=kestrel-brain.service pipewire.service wireplumber.service
After=kestrel-brain.service pipewire.service wireplumber.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
WorkingDirectory=%h/Projects/zaingulel/kestrel
Environment=KESTREL_VOICE=irish-female KESTREL_MANAGED_BRAIN=1
ExecStartPre=+/usr/bin/touch %t/uwsm-app.lock
ExecStartPre=+/usr/bin/mkdir -p %h/Pictures
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/Projects/zaingulel/kestrel/.runtime/hermes-memory %h/Projects/zaingulel/kestrel/.runtime/hermes-traces %h/Projects/zaingulel/kestrel/.runtime/hermes-sessions %h/Projects/zaingulel/kestrel/.runtime/cache
ExecStart=%h/Projects/zaingulel/kestrel/run-voice.sh
ExecStartPost=+/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 MAINPID=${MAINPID} /usr/bin/bash %h/Projects/zaingulel/kestrel/check-network-fence.sh
TimeoutStopSec=15s
Restart=no
KillMode=mixed
StandardOutput=append:%h/Projects/zaingulel/kestrel/.runtime/voice-server.log
StandardError=inherit
ProtectSystem=strict
ProtectHome=tmpfs
PrivateNetwork=yes
PrivateUsers=self
PrivateTmp=disconnected
PrivateDevices=yes
NoNewPrivileges=yes
PrivateIPC=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
InaccessiblePaths=-/dev/shm -/dev/mqueue -/dev/pts -/dev/ptmx -/dev/hugepages -/var/log -/run/log -/run/docker.sock -/run/dbus -/run/systemd -/run/udev -/run/tailscale -/run/cups -/run/avahi-daemon -/run/ssh-unix-local -/run/polkit -/run/containerd -/run/sudo -/run/sddm -/opt/containerd -/var/db/sudo -%h/Projects/zaingulel/kestrel/.git -%h/Projects/zaingulel/kestrel/.claude
ReadOnlyPaths=/run
RuntimeDirectory=kestrel
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
BindPaths=-/dev/nvidia0 -/dev/nvidiactl -/dev/nvidia-uvm -/dev/nvidia-uvm-tools -/dev/nvidia-modeset %h/Projects/zaingulel/kestrel/.runtime/hermes-memory %h/Projects/zaingulel/kestrel/.runtime/hermes-traces %h/Projects/zaingulel/kestrel/.runtime/hermes-sessions %h/Projects/zaingulel/kestrel/.runtime/cache %t/kestrel %t/uwsm-app.lock %h/Pictures
BindReadOnlyPaths=%h/Projects/zaingulel/kestrel %t -%h/.config/user-dirs.dirs -%h/.local/share/applications -%h/.local/share/flatpak/exports/share -%h/.local/share/flatpak/app -%h/.local/bin -%h/Applications

[Install]
WantedBy=graphical-session.target
