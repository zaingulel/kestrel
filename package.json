{
  "name": "kestrel",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint scripts .claude/hooks .codex/hooks",
    "lint:docs": "node scripts/doc-lint.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "test:speech": ".runtime/voice-venv/bin/python -m unittest discover -s tests -v",
    "test": "npm run test:scripts && npm run test:speech"
  },
  "dependencies": {
    "htmlparser2": "10.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0"
  }
}
