{
  "permissions": {
    "allow": [
      "Bash(node scripts/board.mjs *)",
      "Bash(node scripts/board-move.mjs *)",
      "Bash(node scripts/board-add.mjs *)",
      "Bash(node scripts/merge-watch.mjs *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge --auto --squash --delete-branch *)",
      "Bash(gh pr merge --squash --delete-branch --match-head-commit *)",
      "Bash(git worktree add .claude/worktrees/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/block-unsafe-git.mjs\" || { s=$?; [ -z \"$FABRAIK_WORKFLOW_ROOT\" ] || exit 2; exit $s; }"
          },
          {
            "type": "command",
            "command": "node \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/filter-test-output.mjs\" || { s=$?; [ -z \"$FABRAIK_WORKFLOW_ROOT\" ] || exit 2; exit $s; }"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/check-builder-handoff.mjs\" || { s=$?; [ -z \"$FABRAIK_WORKFLOW_ROOT\" ] || exit 2; exit $s; }"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/owner-menu.mjs\" || { s=$?; [ -z \"$FABRAIK_WORKFLOW_ROOT\" ] || exit 2; exit $s; }",
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/owner-menu.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${FABRAIK_WORKFLOW_ROOT:-$CLAUDE_PROJECT_DIR}/.claude/hooks/verify-green.sh\""
          }
        ]
      }
    ]
  }
}
