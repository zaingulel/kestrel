#!/bin/sh
# pre-push — run the gates that must not leave the machine unchecked.
#
#   * the product gate — a push to main is judged first by `scripts/gates/pre-push-main <remote sha>
#     <local sha>` as the remote's main has it, never by the pushed checkout's copy: the hook exports that
#     commit's tree to a temporary directory and runs the gate from inside it, with replacement
#     references off, so every file the gate loads by relative path is the one on main. A gate that is
#     missing or not executable there, or that refuses, blocks the push. Other branches never consult it.
#   * eslint — undefined reference, typo'd name, duplicate key.
#   * the scripts/lib node:test suite — the guard scripts, board scripts and the pre-commit
#     hook. Runs on every push once the dependency prerequisite passes: editing .claude/agents/ or
#     AGENTS.md alone trips no staged-path trigger that runs it.
#   * the Git LFS upload — last, so a push any gate above refuses uploads nothing: a pushed ref whose commits use Git LFS
#     goes to git lfs pre-push, because core.hooksPath displaces the hook Git LFS installs. Without git-lfs
#     that push is refused before lint or tests.
#
# Install dependencies at the repository root before pushing: npm install for a first install
# without a lockfile, or npm ci with an existing lockfile. Missing installed ESLint fails
# before lint or tests. With ESLint available, missing npm skips lint with a warning. The script
# suite is invoked through `node --test` directly, NOT `npm run test:scripts`, so missing npm cannot
# bypass it, and it fails CLOSED on a missing node: every gate this repo has is a node program.
#
# The repository's `npm test` is NOT forced on every push. Opt in with RUN_TESTS=1:
#     RUN_TESTS=1 git push
#
# Escape hatch: `git push --no-verify` bypasses entirely.
set -e

# Git EXPORTS its plumbing env into every hook, and this hook runs the script suite, whose
# test files `git init` throwaway fixture repos. An inherited GIT_DIR points that init at the
# REAL repository and writes `core.bare = true` into the shared config, breaking every
# checkout that shares it. `--local-env-vars` is git's own authoritative list of the
# repository-scoped variables. GIT_NAMESPACE is not in that set, and NODE_TEST_CONTEXT is not
# git's at all but carries the same hazard: an inner `node --test` that inherits it exits 0
# EVEN ON RED. The trace family is scrubbed by prefix because its sub-keys are open-ended.
git_trace_vars=$(
  LC_ALL=C
  set -f
  IFS='
'
  for assignment in $(set); do
    case $assignment in
      (GIT_TRACE*=*)
        name=${assignment%%=*}
        case $name in
          (*[!A-Za-z0-9_]*) ;;
          (*) printf '%s\n' "$name" ;;
        esac
        ;;
    esac
  done
)
unset $(git rev-parse --local-env-vars) $git_trace_vars GIT_NAMESPACE NODE_TEST_CONTEXT \
  GIT_CURL_VERBOSE GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref to stdin.
main_gate=scripts/gates/pre-push-main

# judge_main <remote sha> <local sha>: a subshell, so its export ends with it and its trap removes the
# copy as soon as the push is judged. Every step is checked by hand, because `set -e` is off in a
# function called on the left of `||`.
judge_main() (
  remote_sha=$1
  local_sha=$2
  # The scrub above removed this with the rest. Replacement refs are local: without it the repository
  # could answer for the remote's commit, or for a pushed one, with another object.
  export GIT_NO_REPLACE_OBJECTS=1
  # Git's all-zero object name stands for a ref the remote lacks.
  case $remote_sha in
    (*[!0]*) ;;
    (*)
      echo "pre-push: the remote has no main yet, so there is no gate on main to judge this push; creating main is never a direct push." >&2
      exit 1
      ;;
  esac
  git_dir=$(git rev-parse --absolute-git-dir) || exit 1
  copy=$(mktemp -d "${TMPDIR:-/tmp}/pre-push-main.XXXXXX") || exit 1
  trap 'rm -rf "$copy"' EXIT
  trap 'exit 1' HUP INT TERM
  # A redirect, not a pipe into tar: POSIX sh has no pipefail, so a failed export would go unseen.
  if ! git archive --format=tar "$remote_sha" >"$copy/main.tar"; then
    echo "pre-push: cannot read the remote's main ($remote_sha) from this repository, so its gate cannot judge this push; fetch, rebase onto it and push again, or use a pull request." >&2
    exit 1
  fi
  if ! { mkdir "$copy/main" && tar -xf "$copy/main.tar" -C "$copy/main"; }; then
    echo "pre-push: cannot unpack the remote's main ($remote_sha), so its gate cannot judge this push; push to main through a pull request instead." >&2
    exit 1
  fi
  if [ ! -x "$copy/main/$main_gate" ]; then
    echo "pre-push: $main_gate is missing or not executable on the remote's main ($remote_sha); push to main through a pull request instead." >&2
    exit 1
  fi
  # The gate starts inside the copy, so each file it loads by relative path is main's, and reaches the
  # pushing repository only through git. The two variables sit on this one command: exported, they would
  # send the script suite's fixture repositories to the real one. The inner subshell keeps this one out
  # of the copy, which Windows cannot remove while it is a running process's current directory.
  if ! ( cd "$copy/main" && GIT_DIR=$git_dir GIT_WORK_TREE=$repo_root "$main_gate" "$remote_sha" "$local_sha" ); then
    echo "pre-push: the gate as it stands on the remote's main ($remote_sha) refused this push or could not be run; this checkout's copy of $main_gate was not consulted." >&2
    exit 1
  fi
)

# An attributes line giving a path Git LFS's filter, as `git lfs track` writes it. A comment does not count.
lfs_attribute='^[[:space:]]*[^#[:space:]].*[[:space:]]filter=lfs([[:space:]]|$)'

lfs_unreadable() {
  echo "pre-push: cannot read the attributes files for the pushed commit $1, so whether this push uses Git LFS is unknown; repair them and push again." >&2
  exit 1
}

# carries_lfs <remote> <local sha>: whether the pushed commits use Git LFS, judged from attributes files
# because this machine's config is absent exactly where git-lfs is. This repository's and this user's own
# files, the tip's committed files, or a tracking line the range changed, so a tip that dropped tracking
# still uploads what the range added. A deletion's all-zero name and a tag of a non-commit have no commits to scan.
carries_lfs() {
  git rev-parse -q --verify "$2^{commit}" >/dev/null || return 1
  info_file=$(git rev-parse --git-path info/attributes) || lfs_unreadable "$2"
  # core.attributesFile replaces the per-user default, as it does for Git itself. Status 1 means unset.
  user_file=$(git config --path --get core.attributesFile) || {
    [ $? -eq 1 ] || lfs_unreadable "$2"
    user_file=${XDG_CONFIG_HOME:-$HOME/.config}/git/attributes
  }
  for file in "$info_file" "$user_file"; do
    [ -e "$file" ] || continue
    if grep -qE "$lfs_attribute" "$file"; then
      return 0
    elif [ $? -ne 1 ]; then
      lfs_unreadable "$2"
    fi
  done
  if GIT_NO_REPLACE_OBJECTS=1 git grep -qE "$lfs_attribute" "$2" -- .gitattributes '*/.gitattributes'; then
    return 0
  elif [ $? -ne 1 ]; then
    lfs_unreadable "$2"
  fi
  # --text and --no-textconv: a pushed attribute must not hide a line or run a converter. --full-history
  # and -m: a side branch or a merge may be the only place tracking changed. Git's transfer
  # ignores replacements, so the check and the upload must too.
  changed=$(GIT_NO_REPLACE_OBJECTS=1 git log -1 --format=%H -m --full-history --text --no-textconv -G"$lfs_attribute" "$2" --not --remotes="$1" -- .gitattributes '*/.gitattributes') || lfs_unreadable "$2"
  [ -n "$changed" ]
}

lfs_refs=
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    judge_main "$remote_sha" "$local_sha" </dev/null || exit 1
  fi
  if carries_lfs "$1" "$local_sha" </dev/null; then
    lfs_refs="$lfs_refs$local_ref $local_sha $remote_ref $remote_sha
"
  fi
done

if [ -n "$lfs_refs" ] && ! git lfs version >/dev/null 2>&1; then
  echo "pre-push: this push uses Git LFS (its .gitattributes files or this machine's attributes files set filter=lfs) but git-lfs is not installed on this machine, so its files cannot be uploaded; install Git LFS, run \`git lfs install --skip-repo\` rather than a plain \`git lfs install\`, which conflicts with this hook, and push again." >&2
  exit 1
fi

# Walk the ANCESTOR directories exactly as npm resolves bins: a git worktree under
# .claude/worktrees/ has no node_modules of its own, but `npm run lint` works there via the
# main checkout's.
eslint_bin=""
dir=$repo_root
while :; do
  if [ -x "$dir/node_modules/.bin/eslint" ]; then eslint_bin="$dir/node_modules/.bin/eslint"; break; fi
  parent=$(dirname "$dir")
  [ "$parent" = "$dir" ] && break
  dir=$parent
done
if [ -z "$eslint_bin" ]; then
  printf 'pre-push: eslint is not installed for %s; run npm install there for a first install without a lockfile, or npm ci with an existing lockfile, before pushing.\n' "$repo_root" >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm not found — skipping lint gate." >&2
else
  echo "pre-push: npm run lint…"
  npm run lint --silent
fi

echo "pre-push: node --test scripts/lib/…"
node --test --test-concurrency=2 "scripts/lib/*.test.mjs"

if [ "${RUN_TESTS:-0}" = "1" ]; then
  echo "pre-push: RUN_TESTS=1 → npm test…"
  npm test
fi

# Last, so a push any gate above refuses uploads nothing. Git runs this hook on --dry-run with no signal,
# so a dry run uploads, as Git LFS's own hook does.
if [ -n "$lfs_refs" ]; then
  echo "pre-push: git lfs pre-push…"
  if ! printf '%s' "$lfs_refs" | GIT_NO_REPLACE_OBJECTS=1 git lfs pre-push "$@"; then
    echo "pre-push: git lfs pre-push failed, so this push's Git LFS objects did not all reach the remote and the push is refused; fix the cause above and push again." >&2
    exit 1
  fi
fi

exit 0
